{
  "name": "android-messages-desktop",
  "productName": "Android Messages",
  "description": "Messages for web, as a desktop app",
  "version": "4.0.0",
  "author": "Chris Knepper <chris82thekid@gmail.com>",
  "copyright": "© 2018-2026 Chris Knepper",
  "homepage": "https://github.com/chrisknepper/android-messages-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisknepper/android-messages-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/chrisknepper/android-messages-desktop/issues"
  },
  "main": "app/background.js",
  "build": {
    "appId": "com.knepper.android-messages-desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "joshschools",
        "repo": "android-messages-desktop"
      }
    ],
    "files": [
      "app/**/*",
      "resources/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "afterSign": "config/packaging/notarize.js",
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        "zip",
        "dmg"
      ],
      "entitlements": "config/packaging/macosEntitlements.plist",
      "entitlementsInherit": "config/packaging/macosEntitlements.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "linux": {
      "category": "Chat",
      "artifactName": "${name}-${version}.${ext}",
      "target": [
        "deb",
        "AppImage",
        "pacman"
      ]
    }
  },
  "scripts": {
    "compile": "webpack --config=build/webpack.app.config.js --env production",
    "start": "node build/start.js",
    "release": "npm run compile && electron-builder -mwl",
    "build": "npm run compile && electron-builder --publish never",
    "build-all": "npm run compile && electron-builder -mwl --publish never",
    "generate-icons": "png2icons assets/android_messages_desktop_icon.png resources/icon -all -i"
  },
  "dependencies": {
    "about-window": "^1.15.2",
    "electron-settings": "^4.0.4",
    "electron-updater": "^6.3.9",
    "fs-jetpack": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@electron/notarize": "^2.5.0",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2",
    "png2icons": "^2.0.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}
